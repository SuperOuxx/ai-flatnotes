u95f4\u5143\u7d20\u6765\u7f29\u5c0f\u641c\u7d22\u8303\u56f4\u3002\u90a3\u7b97\u6cd5\u7684\u5927\u81f4\u6b65\u9aa4\u5e94\u8be5\u662f\u8fd9\u6837\u7684\uff1a\u9996\u5148\u786e\u5b9a\u6570\u7ec4\u7684\u4e2d\u95f4\u5143\u7d20\uff0c\u7136\u540e\u6bd4\u8f83\u76ee\u6807\u503c\u548c\u4e2d\u95f4\u5143\u7d20\u7684\u5927\u5c0f\u3002\u5982\u679c\u76ee\u6807\u503c\u7b49\u4e8e\u4e2d\u95f4\u5143\u7d20\uff0c\u5c31\u76f4\u63a5\u8fd4\u56de\u7d22\u5f15\uff1b\u5982\u679c\u76ee\u6807\u503c\u5c0f\u4e8e\u4e2d\u95f4\u5143\u7d20\uff0c\u90a3\u5c31\u5728\u5de6\u534a\u90e8\u5206\u7ee7\u7eed\u67e5\u627e\uff1b\u53cd\u4e4b\u5219\u5728\u53f3\u534a\u90e8\u5206\u67e5\u627e\u3002\u8fd9\u4e2a\u8fc7\u7a0b\u9700\u8981\u4e0d\u65ad\u91cd\u590d\uff0c\u76f4\u5230\u627e\u5230\u76ee\u6807\u503c\u6216\u8005\u786e\u5b9a\u5b83\u4e0d\u5b58\u5728\u4e8e\u6570\u7ec4\u4e2d\u3002\n\n\u90a3\u5177\u4f53\u600e\u4e48\u7528Python\u5b9e\u73b0\u5462\uff1f\u9996\u5148\uff0c\u6211\u9700\u8981\u4e00\u4e2a\u51fd\u6570\uff0c\u53c2\u6570\u5e94\u8be5\u5305\u62ec\u6709\u5e8f\u6570\u7ec4\u548c\u76ee\u6807\u503c\u3002\u7136\u540e\u521d\u59cb\u5316\u5de6\u53f3\u4e24\u4e2a\u6307\u9488\uff0c\u5de6\u6307\u9488\u521d\u59cb\u662f0\uff0c\u53f3\u6307\u9488\u662f\u6570\u7ec4\u957f\u5ea6\u51cf\u4e00\u3002\u7136\u540e\u8fdb\u5165\u4e00\u4e2a\u5faa\u73af\uff0c\u6761\u4ef6\u662f\u5de6\u6307\u9488\u5c0f\u4e8e\u7b49\u4e8e\u53f3\u6307\u9488\u3002\u5728\u5faa\u73af\u91cc\u8ba1\u7b97\u4e2d\u95f4\u7d22\u5f15\uff0c\u8fd9\u91cc\u8981\u6ce8\u610f\u907f\u514d\u6ea2\u51fa\uff0c\u4e0d\u8fc7Python\u7684\u6574\u6570\u5e94\u8be5\u6ca1\u95ee\u9898\uff0c\u76f4\u63a5\u7528\uff08\u5de6 + \u53f3\uff09//2\u5c31\u884c\u3002\u7136\u540e\u6bd4\u8f83\u4e2d\u95f4\u5143\u7d20\u548c\u76ee\u6807\u503c\u3002\u5982\u679c\u76f8\u7b49\uff0c\u8fd4\u56de\u4e2d\u95f4\u7d22\u5f15\u3002\u5982\u679c\u76ee\u6807\u503c\u5c0f\uff0c\u5c31\u628a\u53f3\u6307\u9488\u79fb\u5230\u4e2d\u95f4\u7d22\u5f15\u51cf\u4e00\uff1b\u5426\u5219\u5de6\u6307\u9488\u79fb\u5230\u4e2d\u95f4\u7d22\u5f15\u52a0\u4e00\u3002\u5982\u679c\u5faa\u73af\u7ed3\u675f\u8fd8\u6ca1\u627e\u5230\uff0c\u5c31\u8fd4\u56de-1\u6216\u8005\u5176\u4ed6\u8868\u793a\u672a\u627e\u5230\u7684\u503c\u3002\n\n\u4e0d\u8fc7\uff0c\u53ef\u80fd\u6709\u4e9b\u8fb9\u754c\u6761\u4ef6\u9700\u8981\u8003\u8651\u3002\u6bd4\u5982\u6570\u7ec4\u4e3a\u7a7a\u7684\u60c5\u51b5\uff0c\u8fd9\u65f6\u5019\u5e94\u8be5\u76f4\u63a5\u8fd4\u56de-1\u3002\u6216\u8005\u5728\u8ba1\u7b97\u4e2d\u95f4\u7d22\u5f15\u7684\u65f6\u5019\uff0c\u662f\u5426\u9700\u8981\u8003\u8651\u6574\u6570\u6ea2\u51fa\u7684\u95ee\u9898\uff1f\u4e0d\u8fc7Python\u7684\u6574\u6570\u8303\u56f4\u5f88\u5927\uff0c\u5e94\u8be5\u4e0d\u7528\u8003\u8651\u8fd9\u4e2a\u95ee\u9898\u3002\u6bd4\u5982\u5f53\u6570\u7ec4\u975e\u5e38\u5927\u7684\u65f6\u5019\uff0c\uff08\u5de6+\u53f3\uff09\u53ef\u80fd\u4f1a\u8d85\u8fc7\u4e00\u822c\u7684\u6574\u6570\u8303\u56f4\uff0c\u4f46Python\u81ea\u52a8\u5904\u7406\u5927\u6574\u6570\uff0c\u6240\u4ee5\u6ca1\u95ee\u9898\u3002\n\n\u6d4b\u8bd5\u4e00\u4e0b\uff0c\u6bd4\u5982\u6570\u7ec4\u662f[1,3,5,7,9]\uff0c\u627e5\u7684\u8bdd\u5e94\u8be5\u8fd4\u56de\u7d22\u5f152\u3002\u5982\u679c\u627e10\uff0c\u5e94\u8be5\u8fd4\u56de-1\u3002\u90a3\u4ee3\u7801\u7684\u5927\u81f4\u7ed3\u6784\u5e94\u8be5\u662f\u8fd9\u6837\u7684\uff1a\n\n\u51fd\u6570\u5b9a\u4e49\uff1adef binary_search(arr, target):\n\u521d\u59cb\u5316left = 0\uff0cright = len(arr) - 1\n\u5faa\u73afwhile left <= right:\n\u8ba1\u7b97mid = (left + right) // 2\n\u5982\u679carr[mid] == target\uff0c\u8fd4\u56demid\n\u5426\u5219\u8c03\u6574left\u6216right\n\u5faa\u73af\u7ed3\u675f\u540e\u8fd4\u56de-1\n\n\u5bf9\u4e86\uff0c\u8fd8\u8981\u5904\u7406\u6570\u7ec4\u4e3a\u7a7a\u7684\u60c5\u51b5\uff0c\u6240\u4ee5\u5728\u51fd\u6570\u5f00\u59cb\u65f6\u68c0\u67e5\u4e00\u4e0b\u6570\u7ec4\u957f\u5ea6\u662f\u5426\u4e3a0\uff0c\u6216\u8005\u662f\u5426\u4f20\u5165\u4e86\u4e00\u4e2a\u7a7a\u6570\u7ec4\u3002\u6bd4\u5982\u5982\u679carr\u662f\u7a7a\u7684\uff0c\u76f4\u63a5\u8fd4\u56de-1\u3002\n\n\u90a3\u73b0\u5728\u628a\u8fd9\u4e9b\u903b\u8f91\u5199\u6210\u4ee3\u7801\u3002\u6bd4\u5982\uff1a\n\ndef binary_search(arr, target):\n    left = 0\n    right = len(arr) - 1\n    while left <= right:\n        mid = (left + right) // 2\n        if arr[mid] == target:\n            return mid\n        elif arr[mid] < target:\n            left = mid + 1\n        else:\n            right = mid - 1\n    return -1\n\n\u8fd9\u6837\u5e94\u8be5\u5c31\u53ef\u4ee5\u4e86\u3002\u6d4b\u8bd5\u51e0\u4e2a\u4f8b\u5b50\u3002\u6bd4\u5982\uff1a\n\narr = [1,3,5,7,9]\ntarget =5 \u2192\u8fd4\u56de2\u3002\u6b63\u786e\u3002\ntarget=3 \u2192\u8fd4\u56de1\u3002\n\u5982\u679ctarget=2\uff0c\u5728\u6570\u7ec4\u4e2d\u4e0d\u5b58\u5728\uff0c\u8fd4\u56de-1\u3002\n\n\u90a3\u8fd9\u4e2a\u5b9e\u73b0\u5e94\u8be5\u6ca1\u95ee\u9898\u3002\u4e0d\u8fc7\u6709\u6ca1\u6709\u53ef\u80fd\u54ea\u91cc\u51fa\u9519\u4e86\uff1f\u6bd4\u5982\u5f53\u6570\u7ec4\u957f\u5ea6\u4e3a0\u7684\u65f6\u5019\uff0clen(arr)-1\u4f1a\u662f-1\uff0c\u8fd9\u65f6\u5019\u5faa\u73af\u6761\u4ef6left <= right\u662f0 <= -1\uff0c\u4e0d\u6210\u7acb\uff0c\u6240\u4ee5\u76f4\u63a5\u8fd4\u56de-1\uff0c\u6b63\u786e\u3002\n\n\u90a3\u8fd9\u4e2a\u5b9e\u73b0\u5e94\u8be5\u8986\u76d6\u4e86\u6240\u6709\u7684\u60c5\u51b5\u3002\u662f\u7684\uff0c\u8fd9\u6837\u5e94\u8be5\u6ca1\u95ee\u9898\u3002\n</think>\n\n\u4ee5\u4e0b\u662fPython\u5b9e\u73b0\u7684\u4e8c\u5206\u67e5\u627e\u7b97\u6cd5\uff1a\n\n```python\ndef binary_search(arr, target):\n    left = 0\n    right = len(arr) - 1\n    \n    while left <= right:\n        mid = (left + right) // 2\n        if arr[mid] == target:\n            return mid\n        elif arr[mid] < target:\n            left = mid + 1\n        else:\n            right = mid - 1\n    \n    return -1\n```\n\n**\u7b97\u6cd5\u6b65\u9aa4\u89e3\u6790\uff1a**\n\n1. **\u521d\u59cb\u5316\u6307\u9488**\uff1a`left` \u521d\u59cb\u6307\u5411\u6570\u7ec4\u8d77\u59cb\u4f4d\u7f6e\uff080\uff09\uff0c`right` \u6307\u5411\u6570\u7ec4\u672b\u5c3e\u4f4d\u7f6e\uff08`len(arr) - 1`\uff09\u3002\n\n2. **\u5faa\u73af\u6761\u4ef6**\uff1a\u5f53 `left` \u2264 `right` \u65f6\u6301\u7eed\u67e5\u627e\uff0c\u786e\u4fdd\u641c\u7d22\u533a\u95f4\u6709\u6548\u3002\n\n3. **\u8ba1\u7b97\u4e2d\u95f4\u7d22\u5f15**\uff1a`mid = (left + right) // 2`\uff0c\u4f7f\u7528\u6574\u9664\u786e\u4fdd\u7d22\u5f15\u4e3a\u6574\u6570\u3002\n\n4. **\u6bd4\u8f83\u4e0e\u8c03\u6574\u533a\u95f4**\uff1a\n   - \u82e5\u4e2d\u95f4\u5143\u7d20\u7b49\u4e8e\u76ee\u6807\u503c\uff0c\u76f4\u63a5\u8fd4\u56de `mid`\u3002\n   - \u82e5\u4e2d\u95f4\u5143\u7d20\u5c0f\u4e8e\u76ee\u6807\u503c\uff0c\u8bf4\u660e\u76ee\u6807\u503c\u53ef\u80fd\u5728\u53f3\u534a\u90e8\u5206\uff0c\u8c03\u6574 `left` \u4e3a `mid + 1`\u3002\n   - \u82e5\u4e2d\u95f4\u5143\u7d20\u5927\u4e8e\u76ee\u6807\u503c\uff0c\u8bf4\u660e\u76ee\u6807\u503c\u53ef\u80fd\u5728\u5de6\u534a\u90e8\u5206\uff0c\u8c03\u6574 `right` \u4e3a `mid - 1`\u3002\n\n5. **\u672a\u627e\u5230\u5904\u7406**\uff1a\u82e5\u5faa\u73af\u7ed3\u675f\u672a\u627e\u5230\u76ee\u6807\u503c\uff0c\u8fd4\u56de `-1`\u3002\n\n**\u6ce8\u610f\u4e8b\u9879\uff1a**\n- \u6570\u7ec4\u5fc5\u987b\u4e3a**\u6709\u5e8f\u6570\u7ec4**\uff08\u5347\u5e8f\u6216\u964d\u5e8f\uff09\uff0c\u672c\u4f8b\u9ed8\u8ba4\u6309\u5347\u5e8f\u5904\u7406\u3002\n- \u65f6\u95f4\u590d\u6742\u5ea6\u4e3a **O(log n)**\uff0c\u6548\u7387\u6781\u9ad8\u3002"}]}, {"role": "user", "additional_kwargs": {}, "blocks": [{"block_type": "text", "text": "\u7528Python\u5199\u4e00\u4e2a\u4e8c\u5206\u67e5\u627e\u7b97\u6cd5"}]}]}, "class_name": "SimpleChatStore"}